# LocalToken Rewards Environment Configuration

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Blockchain Configuration
VITE_CHAIN_ID=8453
VITE_CHAIN_NAME=Base
VITE_RPC_URL=https://mainnet.base.org

# Contract Addresses (deployed on Base)
VITE_TOKEN_FACTORY_ADDRESS=0x1234567890123456789012345678901234567890

# WalletConnect Project ID (for RainbowKit)
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Farcaster Configuration
VITE_FARCASTER_HUB_URL=https://hub.farcaster.xyz
VITE_NEYNAR_API_KEY=your-neynar-api-key

# Application Configuration
VITE_APP_NAME=LocalToken Rewards
VITE_APP_DESCRIPTION=Unlock exclusive local rewards with every purchase
VITE_APP_URL=https://localtoken.app

# Feature Flags
VITE_ENABLE_FARCASTER_FRAMES=true
VITE_ENABLE_QR_SCANNING=true
VITE_ENABLE_ANALYTICS=true

# Development Configuration
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info
